{
  "expo": {
    "name": "Calkoul",
    "slug": "calkoul",
    "version": "1.0.0",
    "orientation": "portrait",
    "primaryColor": "#286F49",
    "backgroundColor": "#F7F8F3",
    "icon": "./assets/images/icon.png",
    "scheme": "calkoul",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#125B39",
        "foregroundImage": "./assets/images/calkoul-mark.png",
        "monochromeImage": "./assets/images/calkoul-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calkoul to access your camera to photograph meals.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Calkoul to choose a profile photo.",
          "cameraPermission": "Allow Calkoul to take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F3",
          "image": "./assets/images/calkoul-splash.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31f2d8cb-4605-4ef9-bf4a-14382eb9b756"
      }
    },
    "owner": "ademderbalis-team"
  }
}
